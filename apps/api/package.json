{
  "name": "@poker-range-trainer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b --clean && tsc -b",
    "start": "node dist/server.js",
    "runtime:smoke": "node dist/runtime-smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --tsBuildInfoFile ../../node_modules/.tmp/api.typecheck.tsbuildinfo",
    "lint": "eslint src test",
    "format:check": "prettier --check src test package.json tsconfig.json vitest*.config.ts",
    "pretest": "npm --prefix ../.. run build:packages",
    "test": "vitest run",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@poker-range-trainer/contracts": "^0.1.0",
    "@poker-range-trainer/database": "^0.1.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.12.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  }
}
