# EAS upload exclusions. When this file exists EAS uses it INSTEAD of the
# .gitignore files, so it must be complete on its own.
# Why it exists: the archiver did not honor mobile/.gitignore's `/ios` rule
# when packing from the repo root, so the locally generated 598MB mobile/ios
# (whose Pods and env files carry machine-local absolute paths) was uploaded
# and broke the remote build - hermesc was invoked at a machine-local
# absolute path that does not exist on the builder.

# dependencies (the builder runs its own install)
node_modules/

# locally generated native projects - the builder runs prebuild itself
mobile/ios/
mobile/android/

# build outputs
dist/
dist-ssr/
mobile/dist/
web-build/
coverage/

# Expo local state
.expo/
mobile/.expo/
mobile/expo-env.d.ts
.metro-health-check*

# env files - build-time values come from EAS env vars, never from disk
.env
.env.*
*.local
!.env.example

# secrets and certificates, should any ever appear locally
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# editor and OS noise
.vscode/
.idea/
.DS_Store
*.log
.playwright-mcp/
/*.png
