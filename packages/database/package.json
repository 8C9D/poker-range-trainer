{
  "name": "@poker-range-trainer/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PostgreSQL schema, migrations, and persistence utilities for Poker Range Trainer.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format:check": "prettier --check --ignore-unknown .",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.config.ts src/database.integration.ts"
  },
  "dependencies": {
    "@poker-range-trainer/domain": "^0.1.0",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  }
}
