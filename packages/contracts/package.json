{
  "name": "@poker-range-trainer/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-neutral request and response contracts for Poker Range Trainer APIs.",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b --clean && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile ../../node_modules/.tmp/contracts.typecheck.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@poker-range-trainer/domain": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
