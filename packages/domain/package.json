{
  "name": "@poker-range-trainer/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b --clean && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false --tsBuildInfoFile ../../node_modules/.tmp/domain.typecheck.tsbuildinfo",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.8"
  },
  "exports": {
    "./domain/*": {
      "development": "./dist/domain/*.js",
      "types": "./dist/domain/*.d.ts",
      "import": "./dist/domain/*.js"
    },
    "./types/*": {
      "development": "./dist/types/*.js",
      "types": "./dist/types/*.d.ts",
      "import": "./dist/types/*.js"
    }
  },
  "files": [
    "dist"
  ]
}
