# Optional cloud sync (Supabase). Leave unset to run the app fully local-only.
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API). BOTH must be set for cloud features to
# turn on; if either is missing the app stays in local-only/anonymous mode.
#
# SECURITY: every VITE_-prefixed variable is INLINED into the client bundle and
# is therefore PUBLIC. Only the publishable "anon" key belongs here -- it is
# designed to be exposed and is protected server-side by Row-Level Security.
# NEVER put the Supabase "service_role" key (or any real secret) in a VITE_ var.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
